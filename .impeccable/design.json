  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The single filled action of a view (Start reading, Next question, Run, Test my design).",
      "html": "<button class=\"ds-btn ds-btn-primary\">Start reading <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M9 6l6 6-6 6\"/></svg></button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;gap:8px;min-height:40px;padding:0 18px;border-radius:999px;border:1px solid var(--border-strong,#cdd2da);background:var(--surface,#fff);color:var(--text,#16181d);font:600 15px system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif;cursor:pointer;transition:background .15s,border-color .15s,transform .08s}.ds-btn svg{width:16px;height:16px}.ds-btn:active{transform:scale(.98)}.ds-btn:focus-visible{outline:2px solid var(--link,#0a63c9);outline-offset:2px}.ds-btn-primary{background:var(--link,#0a63c9);border-color:var(--link,#0a63c9);color:var(--on-accent,#fff)}.ds-btn-primary:hover{background:var(--link-hover,#084e9e);border-color:var(--link-hover,#084e9e)}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Every non-primary action: a hairline pill.",
      "html": "<button class=\"ds-btn2\">All cards</button>",
      "css": ".ds-btn2{display:inline-flex;align-items:center;min-height:40px;padding:0 18px;border-radius:999px;border:1px solid var(--border-strong,#cdd2da);background:var(--surface,#fff);color:var(--text,#16181d);font:600 15px system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif;cursor:pointer;transition:background .15s,transform .08s}.ds-btn2:hover{background:var(--surface-2,#f2f4f7)}.ds-btn2:active{transform:scale(.98)}.ds-btn2:focus-visible{outline:2px solid var(--link,#0a63c9);outline-offset:2px}"
    },
    {
      "name": "Segmented Control",
      "kind": "custom",
      "refersTo": "segmented-track",
      "description": "Discrete choices in diagrams and lab setup; kind dot plus word.",
      "html": "<div class=\"ds-seg\"><button class=\"ds-on ds-k-bad\">No fencing</button><button class=\"ds-k-good\">Fencing token</button></div>",
      "css": ".ds-seg{display:inline-flex;gap:2px;padding:3px;border-radius:999px;background:var(--surface-2,#f2f4f7)}.ds-seg button{display:inline-flex;align-items:center;gap:6px;min-height:30px;padding:0 12px;border:0;border-radius:999px;background:transparent;color:var(--text-2,#444b57);font:600 14px system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif;cursor:pointer;transition:background .15s,color .15s}.ds-seg button:hover{color:var(--text,#16181d)}.ds-seg button:focus-visible{outline:2px solid var(--link,#0a63c9);outline-offset:2px}.ds-seg button::before{content:\"\";width:7px;height:7px;border-radius:50%}.ds-seg .ds-k-bad::before{background:var(--k-bad-s,#e5484d)}.ds-seg .ds-k-good::before{background:var(--k-good-s,#0f9f6e)}.ds-seg button.ds-on{background:var(--surface,#fff);color:var(--k-bad-i,#97191d);box-shadow:0 1px 2px rgba(16,24,40,.12),0 0 0 1px var(--border,#e4e7ec)}"
    },
    {
      "name": "Problem and Fix Chips",
      "kind": "chip",
      "refersTo": "chip-problem",
      "description": "The break and the fix under every card lede.",
      "html": "<div style=\"display:flex;gap:8px;flex-wrap:wrap\"><span class=\"ds-chip ds-bad\"><b>Problem</b> Two leaders both write</span><span class=\"ds-chip ds-good\"><b>Fix</b> Fencing tokens</span></div>",
      "css": ".ds-chip{display:inline-flex;align-items:center;gap:8px;min-height:30px;padding:3px 12px;border-radius:999px;font:400 13px/1.35 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif;border:1px solid transparent}.ds-chip b{font-weight:700}.ds-bad{background:var(--k-bad-f,#fdeeee);color:var(--k-bad-i,#97191d);border-color:color-mix(in srgb,var(--k-bad-s,#e5484d) 22%,transparent)}.ds-good{background:var(--k-good-f,#e8f8f0);color:var(--k-good-i,#065f46);border-color:color-mix(in srgb,var(--k-good-s,#0f9f6e) 22%,transparent)}"
    },
    {
      "name": "Sandbox Frame",
      "kind": "card",
      "refersTo": "sandbox",
      "description": "The live diagram frame with Live dot, Restart and Expand.",
      "html": "<div class=\"ds-sb\"><div class=\"ds-sb-bar\"><span class=\"ds-live\"><i></i>Live</span><span style=\"flex:1\"></span><button class=\"ds-fb\">Restart</button><button class=\"ds-fb\">Expand</button></div><div class=\"ds-sb-stage\"><div class=\"ds-cap\">Replica 2 missed the write.</div></div></div>",
      "css": ".ds-sb{border:1px solid var(--border,#e4e7ec);border-radius:16px;background:var(--surface,#fff);box-shadow:0 1px 2px rgba(16,24,40,.05),0 10px 28px -12px rgba(16,24,40,.16);overflow:hidden;font-family:system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}.ds-sb-bar{display:flex;align-items:center;gap:10px;min-height:44px;padding:0 8px 0 16px;background:var(--wash,#f6f7f9);border-bottom:1px solid var(--border,#e4e7ec);font-size:13px;color:var(--text-3,#5d6574)}.ds-live{display:inline-flex;align-items:center;gap:8px;font-weight:600;color:var(--text-2,#444b57)}.ds-live i{width:7px;height:7px;border-radius:50%;background:var(--k-good-s,#0f9f6e)}.ds-fb{min-height:30px;padding:0 10px;border:0;border-radius:999px;background:transparent;color:var(--text-2,#444b57);font:600 13px inherit;cursor:pointer}.ds-fb:hover{background:var(--surface-3,#e5e8ee);color:var(--text,#16181d)}.ds-fb:focus-visible{outline:2px solid var(--link,#0a63c9);outline-offset:2px}.ds-sb-stage{padding:26px 26px 22px}.ds-cap{padding:10px 14px;border-radius:12px;background:var(--k-bad-f,#fdeeee);color:var(--k-bad-i,#97191d);text-align:center;font-size:15px}"
    },
    {
      "name": "Note Callout",
      "kind": "card",
      "refersTo": "callout-note",
      "description": "Fully tinted note with an icon, no side stripe.",
      "html": "<div class=\"ds-callout\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><circle cx=\"12\" cy=\"12\" r=\"8.5\"/><path d=\"M12 11v5M12 8h.01\"/></svg><p><b>Tip.</b> Press / to search from anywhere.</p></div>",
      "css": ".ds-callout{display:flex;gap:14px;align-items:flex-start;padding:16px 20px;border-radius:16px;background:var(--accent-bg,#ebf3fe);color:var(--text-2,#444b57);font:400 15px/1.55 system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}.ds-callout p{margin:0}.ds-callout b{color:var(--text,#16181d)}.ds-callout svg{flex:none;width:20px;height:20px;margin-top:2px;color:var(--link,#0a63c9)}"
    },
    {
      "name": "Sidebar Rows",
      "kind": "nav",
      "refersTo": "side-link",
      "description": "Contents tree; current row in Blue Wash.",
      "html": "<nav class=\"ds-side\"><a class=\"ds-sl\" href=\"#\"><span class=\"n\">4</span>Encoding and Evolution</a><a class=\"ds-sl ds-act\" href=\"#\"><span class=\"n\">5</span>Replication</a><a class=\"ds-sl\" href=\"#\"><span class=\"n\">6</span>Partitioning</a></nav>",
      "css": ".ds-side{display:flex;flex-direction:column;gap:1px;width:260px;font-family:system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif}.ds-sl{display:flex;align-items:center;gap:10px;min-height:36px;padding:6px 10px;border-radius:8px;color:var(--text-2,#444b57);font-size:14px;text-decoration:none;transition:background .15s,color .15s}.ds-sl .n{width:18px;text-align:right;font-size:13px;color:var(--text-3,#5d6574);font-variant-numeric:tabular-nums}.ds-sl:hover{background:var(--surface-2,#f2f4f7);color:var(--text,#16181d)}.ds-sl:focus-visible{outline:2px solid var(--link,#0a63c9);outline-offset:2px}.ds-sl.ds-act{background:var(--accent-bg,#ebf3fe);color:var(--link,#0a63c9);font-weight:600}.ds-sl.ds-act .n{color:inherit}"
    },
    {
      "name": "Search Pill",
      "kind": "input",
      "refersTo": "search-input",
      "description": "Top-bar search; blue edge and wash ring on focus.",
      "html": "<label class=\"ds-search\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><circle cx=\"11\" cy=\"11\" r=\"6.5\"/><path d=\"M20 20l-4.2-4.2\"/></svg><input type=\"search\" placeholder=\"Search cards and terms\"></label>",
      "css": ".ds-search{position:relative;display:block;width:340px}.ds-search svg{position:absolute;left:14px;top:50%;transform:translateY(-50%);width:16px;height:16px;color:var(--text-3,#5d6574)}.ds-search input{width:100%;height:38px;padding:0 16px 0 38px;border-radius:999px;border:1px solid transparent;background:var(--surface-2,#f2f4f7);color:var(--text,#16181d);font:400 14px system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif;outline:none;transition:border-color .15s,background .15s,box-shadow .15s}.ds-search input:hover{border-color:var(--border-strong,#cdd2da)}.ds-search input:focus{background:var(--surface,#fff);border-color:var(--link,#0a63c9);box-shadow:0 0 0 3px var(--accent-bg,#ebf3fe)}"
    },
    {
      "name": "Pager Box",
      "kind": "nav",
      "refersTo": "pager-link",
      "description": "Previous and next boxes at the foot of a card.",
