      "css": ".ds-pager{display:flex;flex-direction:column;gap:2px;justify-content:center;width:300px;min-height:72px;padding:14px 18px;border:1px solid var(--border,#e4e7ec);border-radius:16px;background:var(--surface,#fff);text-decoration:none;font-family:system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif;transition:border-color .15s,box-shadow .15s}.ds-pager small{font-size:13px;color:var(--text-3,#5d6574)}.ds-pager b{font-weight:600;font-size:16px;color:var(--link,#0a63c9)}.ds-pager:hover{border-color:var(--link,#0a63c9);box-shadow:0 1px 2px rgba(16,24,40,.06)}.ds-pager:focus-visible{outline:2px solid var(--link,#0a63c9);outline-offset:2px}"
